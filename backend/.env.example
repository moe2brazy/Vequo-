# ============================================================
# 智能问析后端环境变量模板
# 复制为 .env 并按实际环境填写（.env 含密钥，勿提交到仓库）
# ============================================================

# ── 数据库（PostgreSQL 或 MySQL）──────────────────────────
DB_TYPE=postgresql          # postgresql | mysql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db
DB_USER=your_user
DB_PASSWORD=your_password

# ── LLM（OpenAI 兼容接口，如 Kimi / DeepSeek / 通义等）──────
LLM_MODEL=your-model-name
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.example.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── SQL 生成链路（2026-09-14）────────────────────────────
# SQL 生成/口径推断专用模型：留空=跟随 LLM_MODEL（零回归）。
# 建议显式指定一个**更强的模型**——SQL 生成要选对表/列/关联键/LIMIT/单位，
# 是整个系统里最难的任务；把 flash 档留给意图分类、摘要、推荐追问等轻任务更划算。
# LLM_SQL_MODEL=your-stronger-model-name

# 整条 SQL 生成链的墙钟上限（秒）。此前无上限（推断 15s + 直生 85s，且直生两轮各自
# 重开计时 → 最坏 100s+）。现在推断与直生共享这一个天花板：推断取 SQL_GEN_INFER_RATIO
# 的比例，直生拿剩余时间。
# SQL_GEN_WALL_S=40

# 生成预算中分给「结构化口径推断（MQL）」的比例（0~1，默认 0.65）。
# MQL 路径只让模型选「指标+维度+筛选」，SQL 由确定性编译器拼装 → 列名/关联键由编译器
# 按真实 schema 把关，非法列与错关联在结构上不可能出现；自由生成 SQL 是兜底（拿剩余比例）。
# 调高 = 更稳更准但更依赖编译器覆盖面；调低 = 更多问题交给自由生成。
# SQL_GEN_INFER_RATIO=0.65

# LLM 流式首 token 门（秒，默认 12）：超过该时长仍无任何输出视为模型卡死，立即换路。
# ANALYSIS_FIRST_TOKEN_S=12

# ── LLM 并发控制 ──────────────────────────────────────────
# LLM_MAX_CONCURRENCY=8     # 全局信号量，限制并发 LLM 调用（防打爆 API）

# ── Embedding（语义缓存/记忆检索的向量来源，三级策略自动回退）──
# 优先：本地 sentence-transformers 模型。backend/models/bge-small-zh-v1.5 已随仓库（92MB），
#       **不配这一项即可**——agent/embeddings.py:162 会按 __file__ 自动定位该目录。
#       需 pip install sentence-transformers torch（见 requirements.txt）。
# ⚠️ 不要把 EMBEDDING_MODEL 写成绝对路径：换机器/换目录后必然失效，且会静默降级
#    为 n-gram 哈希向量（只有字面重复能命中，同义改写命中不了）。
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5   # HF hub ID 仅在联网时可用
#                                         #（本项目 .env 有 HF_HUB_OFFLINE=1，hub ID 会失败）
# 其次：独立 OpenAI 兼容 embedding API（无需本地模型）
# EMBEDDING_API_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_API_MODEL=BAAI/bge-m3
# 兜底：零依赖 n-gram 哈希向量（默认启用，无需配置即可用）
# EMBEDDING_DISABLE=1                     # 显式关闭本地模型加载，直接走兜底（省 2GB 依赖）
# EMBEDDING_DISABLE=0        # 1 = 强制禁用 embedding（语义缓存同时失效）

# ── 语义缓存（相似问题复用 SQL）────────────────────────────
# SEMANTIC_CACHE_ENABLED=1
# SEMANTIC_CACHE_THRESHOLD=0.92   # 余弦相似度阈值（越高越保守；ngram 兜底建议保持 0.92）
# SEMANTIC_CACHE_MAX=200          # 每库最多条目
# SEMANTIC_CACHE_TTL_DIM=86400    # 仅维度表条目 TTL（24h）
# SEMANTIC_CACHE_TTL_FACT=900     # 含事实表条目 TTL（15min）
# SEMANTIC_CACHE_PERSIST=1        # 持久化（配 REDIS_URL 后跨重启/跨实例共享；否则内存回退）
# SEMANTIC_CACHE_PERSIST_MAX=50   # 每库持久化条目上限

# ── 结果缓存（SQL 执行结果，精确 key 复用）──────────────────
# REDIS_URL=redis://localhost:6379/0   # 配置后启用 Redis；不配则内存回退
# CACHE_TTL_SECONDS=300                # 默认 TTL（结果缓存按表类型分级：维度表 24h / 事实表 15min）
# CACHE_MAX_ENTRIES=500                # 内存缓存上限

# ── SQL 执行护栏 ──────────────────────────────────────────
# EXPLAIN_GATE_ENABLED=1          # EXPLAIN 干跑闸门（执行前拦全表扫描）
# EXPLAIN_ROW_THRESHOLD=1000000   # 估算行数阈值（超过拒绝，回灌 LLM 改写）

# ── 服务运行 ──────────────────────────────────────────────
# WORKERS=1     # uvicorn worker 数。注意：本项目支持运行时动态切库（进程内全局 engine），
#               # 多进程会导致切库后各进程指向不一致，默认保持单进程
# PORT=8010

# ── 其他开关 ──────────────────────────────────────────────
# ANALYSIS_CONFIRM_ENABLED=1     # 未定义口径时的 LLM 推断 + 弹窗二次确认

# ── 邮箱验证码（注册用）──────────────────────────────────
# 发信邮箱 SMTP 配置（QQ/163/企业邮箱均可；MAIL_SMTP_PASSWORD 填「授权码」而非登录密码）
# QQ 邮箱：smtp.qq.com:465；163：smtp.163.com:465；企业邮箱按服务商文档。
# MAIL_DEBUG=1 时不真正发信，验证码打印到后端日志（未配置 SMTP 时自动进入调试模式）
MAIL_DEBUG=1
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Vequo 维阔
MAIL_CODE_TTL=600          # 验证码有效期（秒）
MAIL_CODE_RESEND_SECONDS=60  # 重发冷却（秒）
