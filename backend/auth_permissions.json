{
  "version": 2,
  "roles": [
    {
      "key": "admin",
      "name": "超级管理员",
      "description": "系统最高权限，不受任何数据权限约束",
      "priority": 100,
      "system": true
    },
    {
      "key": "viewer",
      "name": "普通员工",
      "description": "只读查询，受数据权限约束",
      "priority": 20,
      "system": true
    },
    {
      "key": "prod_staff",
      "name": "生产人员",
      "description": "生产岗位：产量、良率、工单执行。只看生产域及其维表，看不到质量明细与设备停机。",
      "priority": 30,
      "system": false
    },
    {
      "key": "eqp_staff",
      "name": "设备人员",
      "description": "设备岗位：设备台账与停机记录。只看设备域及其维表，看不到产量明细与质检明细。",
      "priority": 30,
      "system": false
    },
    {
      "key": "qc_staff",
      "name": "质量人员",
      "description": "质量岗位：抽检结果与缺陷明细。只看质量域及其维表，看不到产量明细与库存。",
      "priority": 30,
      "system": false
    }
  ],
  "datasets": [
    {
      "key": "prod_core",
      "name": "生产制造域",
      "tables": [
        "mes_process_output",
        "mes_work_order",
        "dim_product",
        "dim_process",
        "dim_production_line"
      ],
      "description": "MES 生产事实表与生产主数据",
      "sensitive": false
    },
    {
      "key": "quality",
      "name": "质量域",
      "tables": [
        "qms_inspection",
        "qms_defect_detail"
      ],
      "description": "检验与不良明细",
      "sensitive": false
    },
    {
      "key": "equipment",
      "name": "设备域",
      "tables": [
        "dim_equipment",
        "eqp_downtime_record"
      ],
      "description": "设备主数据与停机记录",
      "sensitive": false
    },
    {
      "key": "inventory",
      "name": "库存域",
      "tables": [
        "inv_inventory_snapshot",
        "test_materials"
      ],
      "description": "库存快照与物料（含成本价，敏感）",
      "sensitive": true
    },
    {
      "key": "sales",
      "name": "销售域",
      "tables": [
        "test_orders",
        "test_factories"
      ],
      "description": "订单与工厂（含客户、单价，敏感）",
      "sensitive": true
    },
    {
      "key": "erp",
      "name": "经营数据(123库)",
      "tables": [
        "factory.sales_order",
        "factory.sales_order_item",
        "factory.product",
        "factory.purchase_order",
        "factory.purchase_order_item",
        "factory.material",
        "factory.quality_inspection",
        "factory.production_record",
        "factory.production_line",
        "factory.workshop",
        "factory.work_order",
        "factory.inventory",
        "factory.equipment",
        "factory.equipment_maintenance"
      ],
      "description": "123库 ERP 经营数据（销售/采购/生产/质检/设备/库存）",
      "sensitive": true
    },
    {
      "key": "hr",
      "name": "人事(123库)",
      "tables": [
        "factory.attendance",
        "factory.employee"
      ],
      "description": "考勤与员工主数据（敏感）",
      "sensitive": true
    },
    {
      "key": "dim_common",
      "name": "公共维表",
      "tables": [
        "dim_production_line",
        "dim_product",
        "dim_process",
        "dim_equipment"
      ],
      "description": "产线 / 产品 / 工序 / 设备四张描述性维表。各岗位共享，用于按维度下钻；不含产量、质检、停机等业务明细。",
      "sensitive": false
    }
  ],
  "policies": {
    "viewer": {
      "datasets": [
        "equipment",
        "quality",
        "inventory",
        "prod_core"
      ],
      "tables": [],
      "rows": {
        "test_factories": {
          "expr": "city = ${user.region}",
          "enabled": true,
          "note": "快捷向导-只看本区域工厂",
          "rule": {
            "field": "city",
            "op": "eq",
            "source": "user.region"
          }
        },
        "test_orders": {
          "expr": "factory_id IN (SELECT factory_id FROM test_factories WHERE city = ${user.region})",
          "enabled": true,
          "note": "快捷向导-只看本区域订单",
          "rule": {
            "op": "in_subquery",
            "ref_table": "test_factories",
            "on": {
              "left": "factory_id",
              "right": "factory_id"
            },
            "where": {
              "field": "city",
              "op": "eq",
              "source": "user.region"
            }
          }
        }
      },
      "columns": {
        "test_orders": {
          "customer_name": {
            "mode": "mask",
            "note": "快捷向导-客户名脱敏",
            "mask": "partial_1_1",
            "agg_ok": false
          }
        },
        "test_materials": {
          "unit_cost": {
            "mode": "mask",
            "note": "快捷向导-成本价模糊化",
            "mask": "round_100",
            "agg_ok": false
          }
        },
        "dim_production_line": {
          "supervisor": {
            "mode": "mask",
            "note": "快捷向导-负责人脱敏",
            "mask": "partial_1_1",
            "agg_ok": false
          }
        },
        "dim_equipment": {
          "equipment_id": {
            "mode": "mask",
            "note": "",
            "mask": "partial_1_1",
            "agg_ok": false
          },
          "equipment_code": {
            "mode": "mask",
            "note": "",
            "mask": "partial_3_4",
            "agg_ok": false
          }
        }
      },
      "metrics": {},
      "actions": {
        "export": true,
        "share": true,
        "download": true
      }
    },
